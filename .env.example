# ================================
# 1 MILHÃO DE INFLUENCER — ENV
# Copie para .env.local e preencha
# ================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="1 Milhão de Influencer"

# --- BANCO DE DADOS ---
# Neon Postgres: https://neon.tech
# Crie um projeto, copie a connection string
DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/1milhao?sslmode=require

# --- AUTH (Clerk) ---
# https://clerk.com → criar app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/meu-painel
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/comprar

# --- CACHE (Upstash Redis) ---
# https://upstash.com → criar database
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# --- PAGAMENTO (Stripe) ---
# https://stripe.com → chaves no dashboard
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Preço criado no Stripe para 1 pixel (R$ 0,01)
# Quantidade multiplicada pelo número de pixels
STRIPE_PIXEL_PRICE_ID=price_xxx

# --- PAGAMENTO (Mercado Pago) ---
# https://mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
MERCADOPAGO_WEBHOOK_SECRET=xxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxx

# --- WEBSOCKET (Ably) ---
# https://ably.com → criar app
ABLY_API_KEY=xxx.xxx:xxx
NEXT_PUBLIC_ABLY_KEY=xxx.xxx:xxx

# --- EMAIL (Resend) ---
# https://resend.com → criar API key
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=ola@1milhaoinfluencer.com.br

# --- STORAGE (Vercel Blob) ---
# Vercel dashboard → projeto → Storage → Create Database → Blob
# Em produção a Vercel injeta essa var sozinha ao conectar o Blob store ao projeto.
# Localmente: `vercel env pull .env.local` depois de conectar, ou cole o token aqui.
BLOB_READ_WRITE_TOKEN=xxx

# --- FEATURE FLAGS ---
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_PIXEL_PRICE=0.10
NEXT_PUBLIC_MIN_PIXELS=100
NEXT_PUBLIC_TOTAL_PIXELS=1000000
